// onboarding
"onbording_overview_title" = "AWAREについて";
"onbording_overview_body"  = "AWAREはスマートフォンのセンサデータ及びコンテキストを手軽に記録・可視化し、必要に応じて研究者と共有するためのフレームワークです。";

"onbording_data_title" = "個人利用：行動記録";
"onbording_data_body"  = "AWAREを使えば、スマートフォンに搭載された物理・仮想センサのデータをアプリを使っていない時でも自動的に記録できます。例えば、あなたの位置情報を24時間記録し、後から振り返ることができます。データはあなたのスマートフォンの中（SQLite）に保存されています。\n一部のセンサ（HealthKitや環境音、位置情報、行動認識など）の利用には、許可が必要なため、必要に応じて許可を求めます。";

"onbording_study_title" = "研究者：実験の実施";
"onbording_study_body" = "スマートフォンを使った調査研究を3ステップで実施できます。（1）参加者のスマートフォンにAWAREをインストールし、（2）ウェブダッシュボードから収集するデータを選択、最後に（3）参加者にQRコードを配布し、AWAREで読み込むだけです。\n\n収集したデータは、一旦スマートフォン上のストレージに保存され、WiFiに接続・充電が行われている時に自動的にアップロードされます。また、AWAREはプライバシーに考慮した設計になっており、個人情報は保存しません。";

"onboarding_permission_loc_title" = "許可：位置情報";
"onboarding_permission_loc_body" = "バックグランドでデータ収集を行う為に、AWAREは「常に」位置情報センサを利用する必要があります。「許可」ボタンを押して位置情報センサの利用を許可して下さい。\n（注意：あなたが、位置情報センサへの利用を許可しない限り、AWAREはバックグランド状態の時にデータを収集できません。）";

"onboarding_permission_notif_title" = "許可：Push通知";
"onboarding_permission_notif_body" = "「アンケート調査のリマインド」や「実験の開始・終了」、「最新のアプリ情報」を受け取る為に、AWAREはPush通知を利用します。「許可」ボタンを押して、Push通知の利用を許可して下さい。";

"onboarding_welcome_title" = "AWARE Frameworkへようこそ！";
"onboarding_welcome_body" = "AWARE Framework の詳細は、以下のリンクからアクセスできます。\nhttp://www.awareframework.com/";


